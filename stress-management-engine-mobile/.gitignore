# Dependencies
/node_modules/

# Expo
/.expo/
/.expo-shared/
/expo-env.d.ts

# Local environment files. Keep the safe template in version control.
.env
.env.*
!.env.example
.env*.local

# Build output and test artifacts
/dist/
/web-build/
/coverage/

# Native build artifacts (keep native project source files trackable)
/android/.gradle/
/android/app/build/
/android/build/
/android/.cxx/
/ios/build/
/ios/Pods/
/ios/*.xcworkspace/xcuserdata/
/ios/*.xcodeproj/xcuserdata/
*.xcuserstate

# Metro and local caches
/.metro-health-check*
/.cache/

# Operating system and editor files
.DS_Store
Thumbs.db
/.idea/
/.vscode/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
